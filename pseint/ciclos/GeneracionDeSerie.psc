// 11. Generación de Serie: Imprime números comenzando en 1, e incrementando en 3 en
// cada paso, mientras el número no supere el valor de 50.
Algoritmo GeneracionDeSerie
    Definir num Como Entero
    num = 1
    
    Mientras num <= 50 Hacer
        Escribir num
        num = num + 3
    FinMientras
FinAlgoritmo